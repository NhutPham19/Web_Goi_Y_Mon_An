# ==========================================
# FLASK CONFIG
# ==========================================
FLASK_ENV=development
SECRET_KEY=thay_bang_chuoi_random_dai_it_nhat_32_ky_tu

# ==========================================
# DATABASE — Supabase PostgreSQL
# Lấy từ: Supabase Dashboard -> Settings -> Database -> Connection string (URI)
# ==========================================
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ==========================================
# JWT
# ==========================================
JWT_SECRET_KEY=thay_bang_chuoi_khac_random_dai_it_nhat_32_ky_tu

# ==========================================
# CLOUDINARY
# Lấy từ: cloudinary.com -> Dashboard -> API Keys
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

